{
  "name": "bplist-lossless",
  "type": "module",
  "version": "0.1.1",
  "author": "Leon Si <leon@leonsilicon.com>",
  "license": "MIT",
  "module": "./dist/exports/main.js",
  "types": "./dist/exports/main.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "bplist",
    "plist",
    "binary-plist",
    "plist-parser",
    "bplist-parser",
    "plist-serializer",
    "bplist-serializer",
    "plist-writer",
    "apple-plist",
    "ios-plist",
    "macos-plist",
    "binary-data",
    "serialization",
    "lossless",
    "roundtrip"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/leonsilicon/bplist-lossless.git"
  },
  "exports": {
    ".": {
      "types": "./dist/exports/main.d.ts",
      "default": "./dist/exports/main.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.3.0",
    "fast-check": "^4.6.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
